# =========================================================================
# SERVER-SIDE VISITOR COUNTER (Persistent Database via Upstash Redis / Vercel KV)
# SECURITY: Never prefix these with VITE_ — keep all credentials strictly server-side.
# Configure these in Vercel Project Settings -> Environment Variables.
# =========================================================================

# Option A: Upstash Redis REST API (Primary recommended names)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Option B: Vercel KV / Upstash Integration Aliases (Supported automatically)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Dedicated cryptographic salt for one-way SHA-256 visitor & rate-limit hashes.
# Generate a strong random value (e.g. `openssl rand -hex 32`) in Vercel Production.
VISITOR_HASH_SALT=""
